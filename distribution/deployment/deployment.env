# Non-secret defaults. Relative repository paths are based on this directory.
PI_TARGET_REPO=..
PI_CONTROL_PORT=8765
PI_BIND_HOST=127.0.0.1
# Default: pinned EmbeddingGemma 2 Q8_0 GGUF (~310 MB) plus the Q8_0
# multimodal projector (~555 MB) on the managed llama.cpp sidecar. Text,
# image and audio embeddings are served through /v1/embeddings.
# Native PyTorch remains opt-in: gemma-torch.
PI_EMBEDDING_MODEL=gemma
PI_EMBEDDING_DEVICE=cpu
PI_DOCLING_ENABLED=1
# Export HF_TOKEN in your shell only if selecting a gated model.

# Inference backend: auto (detect cuda -> vulkan -> cpu), cpu, vulkan or cuda.
# The GPU is an optimisation: an unavailable or unusable GPU degrades to the
# validated CPU profile instead of failing the deployment.
PI_ACCELERATOR=auto

# Optional device from llama-server --list-devices (e.g. Vulkan1 or CUDA0).
# PI_GPU_DEVICE=Vulkan0
# Optional chat-shaped project retrieval frontend, no chat LLM required.
# COMPOSE_PROFILES=open-webui
# PI_OPEN_WEBUI_PORT=8768
# PI_WEBUI_NAME=ProjectExpert
# Set PI_OPEN_WEBUI_API_KEY privately only when the project API requires it.
# Optional ProjectExpert API bearer password. Unset by default on loopback.
# Set PI_UI_TOKEN privately in the environment; do not commit a real value here.

# auto chooses managed volume for Windows/WSL sources when the packaged helper is available.
PI_WORKSPACE_MODE=auto

# Staged production-indexing rollout; enable after local migration verification.
PI_INDEX_ENGINE=legacy
PI_INDEX_PARALLEL=0
PI_INDEX_REQUIRE_COMPLETE=1
PI_EMBED_BATCHING=0
PI_CPU_TARGET_PERCENT=80
PI_PARSE_WORKERS=auto

# PDF subprocess concurrency remains opt-in pending real-model RSS acceptance.
PI_PDF_WORKERS=1
PI_PDF_THREADS=1
