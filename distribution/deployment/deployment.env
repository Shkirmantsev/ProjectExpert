# Non-secret defaults. Relative repository paths are based on this directory.
PI_TARGET_REPO=..
PI_CONTROL_PORT=8765
PI_BIND_HOST=127.0.0.1
# Default: pinned EmbeddingGemma 2 Q8_0 GGUF (~310 MB) plus the Q8_0
# multimodal projector (~555 MB) on the managed llama.cpp sidecar. Text,
# image and audio embeddings are served through /v1/embeddings.
# Native PyTorch remains opt-in: gemma-torch.
PI_EMBEDDING_MODEL=gemma
PI_EMBEDDING_DEVICE=cpu
PI_DOCLING_ENABLED=1
# Export HF_TOKEN in your shell only if selecting a gated model.

# Inference backend: auto (detect cuda -> vulkan -> cpu), cpu, vulkan or cuda.
# The GPU is an optimisation: an unavailable or unusable GPU degrades to the
# validated CPU profile instead of failing the deployment.
PI_ACCELERATOR=auto

# Optional device from llama-server --list-devices (e.g. Vulkan1 or CUDA0).
# PI_GPU_DEVICE=Vulkan0
# Optional chat-shaped project retrieval frontend, no chat LLM required.
# COMPOSE_PROFILES=open-webui
# PI_OPEN_WEBUI_PORT=8768
# PI_WEBUI_NAME=ProjectExpert
# Set PI_OPEN_WEBUI_API_KEY privately only when the project API requires it.
# Optional ProjectExpert API bearer password. An absent or empty value in
# the container grants full UI access to everyone who can reach the service.
# Set PI_UI_TOKEN privately in the environment; do not commit a real value here.
# Knowledge sharing is configured in the UI and retained in private runtime
# storage across kit upgrades. Automatic export defaults off. The authenticated
# UI issues scoped server-side approvals; no signing secret is sent to browsers.
# Headless compatibility only: PI_PORTABLE_EXPORT=off|review|approved-auto,
# PI_PORTABLE_VECTORS=0|1. Supply operator keys through a private mounted file
# (PI_OPERATOR_APPROVAL_KEY_FILE inside the container), not this committed file.

# auto chooses managed volume for Windows/WSL sources when the packaged helper is available.
PI_WORKSPACE_MODE=auto

# Optimized defaults for fresh kits; explicit legacy/0/0 remains available for rollback.
PI_INDEX_ENGINE=resumable
PI_INDEX_PARALLEL=1
PI_INDEX_REQUIRE_COMPLETE=1
PI_EMBED_BATCHING=1
PI_CPU_TARGET_PERCENT=80
PI_PARSE_WORKERS=auto

# PDF subprocess concurrency remains opt-in pending real-model RSS acceptance.
PI_PDF_WORKERS=1
PI_PDF_THREADS=1

# Reviewed immutable asset release; populated by the release kit build.
# Existing deployment.env is preserved by --upgrade: explicitly review these pins.
PI_ASSET_IMAGE=
PI_ASSET_MANIFEST_SHA256=

# Optional Windows host CUDA runtime (not passed into the application container).
# See WINDOWS_NATIVE_GPU_RECOVERY.md; no optional pack is downloaded by default.
# PI_NATIVE_CUDA_SOURCE=disabled
# PI_NATIVE_CUDA_LOCAL_ROOT=C:\ApprovedAssets\cuda-candidate
# PI_NATIVE_CUDA_MANIFEST_SHA256=<independently reviewed manifest hash>
# PI_NATIVE_CUDA_IMAGE=<approved immutable companion repository@sha256:digest>
# PI_ACCELERATOR_STRICT=1
