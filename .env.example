# =============================================================================
# HARNESS-LAYOUT — single user configuration file
# Run `make init`, then edit only `.env`.
# AUTO_GENERATE/auto values are resolved locally without changing this template.
# =============================================================================

# --- Project / main machine ---------------------------------------------------
PROJECT_ROOT=auto
HARNESS_PROJECT_ID=my-project
MAIN_UID=auto
MAIN_GID=auto
MAIN_TAILSCALE_HOST=auto
MAIN_TAILSCALE_IP=auto

# --- Feature switches ---------------------------------------------------------
# Portable default: core harness only. All model/runtime/web integrations are opt-in.
# This lets the repository work without Docker, LiteLLM, Hermes, or local models.
PROJECT_CONTEXT_MCP_ENABLED=true
# stdio: clients manage their own server. http: connect to make run-mcp.
PROJECT_CONTEXT_MCP_TRANSPORT=stdio
PROJECT_CONTEXT_MCP_PORT=18883
LITELLM_ENABLED=false
HERMES_ENABLED=false
WEB_SEARCH_ENABLED=false
CRAWL4AI_ENABLED=false
PLAYWRIGHT_ENABLED=false
LITELLM_EXPOSE_ON_TAILSCALE=false

# --- Docker -------------------------------------------------------------------
HARNESS_DOCKER_AUTH_MODE=anonymous
DOCKER_LOG_MAX_SIZE=5m
DOCKER_LOG_MAX_FILES=2

# --- Native remote Hermes -----------------------------------------------------
# OpenCode uses project-local custom tools that call native Hermes /v1/runs directly.
HERMES_REMOTE_SCHEME=http
HERMES_REMOTE_HOST=CHANGE_ME_TAILSCALE_DNS
HERMES_REMOTE_OPENAI_PORT=8642
HERMES_REMOTE_API_KEY=CHANGE_ME_FROM_REMOTE_HERMES
HERMES_REMOTE_MODEL=hermes-tailscale-worker
HERMES_MIN_VERSION=0.20.5

# Claude Code uses a dedicated MCP sidecar on the remote Hermes host.
# The sidecar controls Hermes runs only; it never proxies project files.
HERMES_SIDECAR_SCHEME=http
HERMES_REMOTE_SIDECAR_PORT=8775
HERMES_SIDECAR_TOKEN=CHANGE_ME_FROM_REMOTE_SIDECAR

# Main-PC account used by Hermes' native SSH backend.
HERMES_PROJECT_USER=hermes-worker
# SSH/login account used by the main PC to copy setup files to the remote host.
HERMES_REMOTE_OS_USER=hermes
# Actual Linux service account/home that owns and runs Hermes. This may differ
# from HERMES_REMOTE_OS_USER (for example copy user=dimitri, runtime user=hermes).
HERMES_REMOTE_RUNTIME_USER=hermes
HERMES_REMOTE_RUNTIME_HOME=/srv/ai/hermes
# Neutral read-only staging path used by `make hermes-sidecar-copy` so the
# runtime user can read the sidecar source even when the SSH copy user differs.
HERMES_REMOTE_STAGING_DIR=/var/tmp/harness-hermes-worker-mcp
HERMES_REMOTE_PROFILE=hermes-tailscale-worker
HERMES_SSH_PORT=22
HERMES_USE_TAILSCALE_SSH=true
# Relative paths kept inaccessible to the dedicated account. Comma-separated.
HERMES_PROJECT_DENY_GLOBS=.env,.env.*,secrets,.generated

# --- LiteLLM ------------------------------------------------------------------
LITELLM_VERSION=1.98.0
LITELLM_PORT=18400
LITELLM_MASTER_KEY=AUTO_GENERATE
LITELLM_LOG=INFO

# --- LM Studio / local model slots -------------------------------------------
LM_STUDIO_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
DEFAULT_REASONING_EFFORT=medium

# Slot 1 and 2 are examples/defaults only. Change aliases and model IDs freely.
LOCAL_MODEL_1_ENABLED=false
LOCAL_MODEL_1_ALIAS=gemma
LOCAL_MODEL_1_CLAUDE_ALIAS=claude-gemma
LOCAL_MODEL_1_DISPLAY_NAME=Local Gemma
LOCAL_MODEL_1_MODEL_ID=google/gemma-4-26b-a4b-qat
LOCAL_MODEL_1_REASONING_MODE=system-guidance
LOCAL_MODEL_1_MAX_OUTPUT_TOKENS=4096

LOCAL_MODEL_2_ENABLED=false
LOCAL_MODEL_2_ALIAS=bonsai
LOCAL_MODEL_2_CLAUDE_ALIAS=claude-bonsai
LOCAL_MODEL_2_DISPLAY_NAME=Local Bonsai
LOCAL_MODEL_2_MODEL_ID=prism-ml/bonsai-27b
LOCAL_MODEL_2_REASONING_MODE=system-guidance
LOCAL_MODEL_2_MAX_OUTPUT_TOKENS=4096

LOCAL_MODEL_3_ENABLED=false
LOCAL_MODEL_3_ALIAS=local-3
LOCAL_MODEL_3_CLAUDE_ALIAS=claude-local-3
LOCAL_MODEL_3_DISPLAY_NAME=Local Model 3
LOCAL_MODEL_3_MODEL_ID=CHANGE_ME
LOCAL_MODEL_3_REASONING_MODE=system-guidance
LOCAL_MODEL_3_MAX_OUTPUT_TOKENS=4096

LOCAL_MODEL_4_ENABLED=false
LOCAL_MODEL_4_ALIAS=local-4
LOCAL_MODEL_4_CLAUDE_ALIAS=claude-local-4
LOCAL_MODEL_4_DISPLAY_NAME=Local Model 4
LOCAL_MODEL_4_MODEL_ID=CHANGE_ME
LOCAL_MODEL_4_REASONING_MODE=system-guidance
LOCAL_MODEL_4_MAX_OUTPUT_TOKENS=4096

# REASONING_MODE: off | system-guidance | native | native+system-guidance
CLAUDE_OPUS_MODEL_NAME=claude-opus-5
CLAUDE_OPUS_LOCAL_ALIAS=bonsai
CLAUDE_SONNET_MODEL_NAME=claude-sonnet-5
CLAUDE_SONNET_LOCAL_ALIAS=bonsai
CLAUDE_HAIKU_MODEL_NAME=claude-haiku-4-5,claude-haiku-4-5-20251001
CLAUDE_HAIKU_LOCAL_ALIAS=gemma

# --- Direct MiniMax -----------------------------------------------------------
MINIMAX_ENABLED=false
MINIMAX_ALIAS=minimax
MINIMAX_CLAUDE_ALIAS=claude-minimax
MINIMAX_DISPLAY_NAME=MiniMax M3
MINIMAX_MODEL_ID=MiniMax-M3
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_TOKEN_PLAN_KEY=CHANGE_ME_SK_CP
MINIMAX_ALWAYS_ADAPTIVE=true

# --- OpenCode compatibility ----------------------------------------------------
# v1 = current production/stable generation (default).
# v2 = OpenCode 2 beta native schema; use only when intentionally running opencode2.
OPENCODE_CONFIG_GENERATION=v1

# --- Claude Code --------------------------------------------------------------
# false preserves a normal Claude login/subscription for the main Claude agent.
# Remote Hermes MCP delegation works independently of this switch.
CLAUDE_CODE_USE_LITELLM=false
CLAUDE_DEFAULT_MODEL=opus
CLAUDE_DEFAULT_EFFORT=medium
CLAUDE_DISPATCHER_MODEL=haiku

# --- SearXNG: optional search discovery --------------------------------------
SEARXNG_VERSION=2026.8.22-9fea41204
SEARXNG_PORT=18080
SEARXNG_MCP_PORT=18880
SEARXNG_SECRET=AUTO_GENERATE

# --- Crawl4AI: optional crawl/render/extraction -------------------------------
CRAWL4AI_VERSION=0.9.2
CRAWL4AI_API_TOKEN=AUTO_GENERATE
CRAWL4AI_PORT=11235
CRAWL4AI_MCP_BRIDGE_PORT=18882

# --- Playwright MCP: optional interactive UI testing --------------------------
PLAYWRIGHT_MCP_IMAGE=mcr.microsoft.com/playwright/mcp@sha256:18c0a9c934004fe9580cc79f1e8e6e6cde7c667348b215335e8a23fd3e509804
PLAYWRIGHT_MCP_PORT=8931

# --- Memory ceilings (limits, not reservations) -------------------------------
MEMORY_LITELLM=1536m
MEMORY_LITELLM_EDGE=64m
MEMORY_SEARXNG=192m
MEMORY_SEARXNG_MCP=96m
MEMORY_CRAWL4AI=1536m
MEMORY_CRAWL4AI_BRIDGE=96m
MEMORY_PLAYWRIGHT_MCP=1g
SHM_CRAWL4AI=256m
SHM_PLAYWRIGHT_MCP=256m

# --- Context7: optional hosted library documentation MCP ----------------------
CONTEXT7_MCP_ENABLED=false
CONTEXT7_MCP_URL=https://mcp.context7.com/mcp
CONTEXT7_MCP_API_KEY=
