# Bind only to the remote host's Tailscale address.
SIDECAR_TAILSCALE_HOST=CHANGE_ME_TAILSCALE_DNS
SIDECAR_TAILSCALE_IP=CHANGE_ME_TAILSCALE_IP
SIDECAR_PORT=8775
HERMES_SIDECAR_TOKEN=AUTO_GENERATE

# Native Hermes API on the SAME remote host. IMPORTANT: server ROOT, no /v1.
HERMES_API_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=CHANGE_ME_EXISTING_API_SERVER_KEY
# os.pathsep-separated canonical roots; ':' on Linux, ';' on Windows.
HERMES_ALLOWED_PROJECT_ROOTS=/srv/projects/harness-layout
LOG_LEVEL=INFO

# Existing worker profile path; resolve with `hermes profile show hermes-tailscale-worker`.
HERMES_PROFILE_HOME=CHANGE_ME_EXISTING_PROFILE_PATH
